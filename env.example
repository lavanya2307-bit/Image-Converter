# Local development defaults
PORT=3000
NODE_ENV=development
HOST=0.0.0.0
DB_PATH=./image-converter.db

# OWNER / ADMIN — set real values only in your local .env or hosting dashboard
ADMIN_EMAIL=your-owner-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-secret

# Optional owner email notification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
OWNER_EMAIL=your-owner-email@example.com
